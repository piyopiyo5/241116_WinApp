<Window x:Class="SuperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuperApp"
        mc:Ignorable="d"
        Title="SuperApp" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ヘルプ (_H)">
                <MenuItem Header="バージョン情報" Click="OnVersionInfoMenuClick"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ClockText" FontSize="14" HorizontalAlignment="Right"/>
            </StatusBarItem>
        </StatusBar>
        <Grid DockPanel.Dock="Top">
            
        </Grid>
    </DockPanel>
</Window>
