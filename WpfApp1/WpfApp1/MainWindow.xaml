<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Communication Test" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 設定部分 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <GroupBox Header="接続設定">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 通信方式選択 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="通信方式:"/>
                    <ComboBox x:Name="CommunicationTypeComboBox" Grid.Row="0" Grid.Column="1" Margin="5"
                              SelectionChanged="CommunicationTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                        <ComboBoxItem Content="Serial"/>
                    </ComboBox>

                    <!-- TCP/UDP設定 -->
                    <Label Grid.Row="0" Grid.Column="2" Content="使用NIC:"/>
                    <ComboBox x:Name="NetworkInterfaceComboBox" Grid.Row="0" Grid.Column="3" Margin="5"/>

                    <!-- IP/ポート設定 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="アドレス:"/>
                    <TextBox x:Name="AddressTextBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="ポート:"/>
                    <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="3" Margin="5"/>

                    <!-- シリアル設定（初期状態で非表示） -->
                    <Label x:Name="SerialPortLabel" Grid.Row="1" Grid.Column="0" Content="COMポート:" Visibility="Collapsed"/>
                    <ComboBox x:Name="SerialPortComboBox" Grid.Row="1" Grid.Column="1" Margin="5" Visibility="Collapsed"/>
                    <Label x:Name="BaudRateLabel" Grid.Row="1" Grid.Column="2" Content="ボーレート:" Visibility="Collapsed"/>
                    <ComboBox x:Name="BaudRateComboBox" Grid.Row="1" Grid.Column="3" Margin="5" Visibility="Collapsed">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- ログ表示 -->
        <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ConnectButton" Content="接続" Width="80" Click="ConnectButton_Click"/>
            <Button x:Name="DisconnectButton" Content="切断" Width="80" Margin="10,0,0,0" Click="DisconnectButton_Click" IsEnabled="False"/>
            <Button x:Name="SendTestButton" Content="テスト送信" Width="80" Margin="10,0,0,0" Click="SendTestButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
