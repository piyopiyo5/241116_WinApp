<UserControl x:Class="WpfApp1.Controls.CommonWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Controls"
             x:Name="commonWindow"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 設定部分 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <GroupBox Header="接続設定">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 通信方式選択 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="通信方式:"/>
                    <ComboBox x:Name="CommunicationTypeComboBox" Grid.Row="0" Grid.Column="1" Margin="2"
                              SelectionChanged="CommunicationTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                        <ComboBoxItem Content="Serial"/>
                    </ComboBox>

                    <!-- TCP/UDP設定 -->
                    <Label x:Name="NetworkInterfaceLabel" Grid.Row="1" Grid.Column="0" Content="使用NIC:"/>
                    <ComboBox x:Name="NetworkInterfaceComboBox" Grid.Row="1" Grid.Column="1" Margin="2"/>

                    <!-- IP/ポート設定 -->
                    <Label x:Name="AddressLabel" Grid.Row="2" Grid.Column="0" Content="アドレス:"/>
                    <TextBox x:Name="AddressTextBox" Grid.Row="2" Grid.Column="1" Margin="2"/>
                    <Label x:Name="PortLabel" Grid.Row="3" Grid.Column="0" Content="ポート:"/>
                    <TextBox x:Name="PortTextBox" Grid.Row="3" Grid.Column="1" Margin="2"/>

                    <!-- シリアル設定（初期状態で非表示） -->
                    <Label x:Name="SerialPortLabel" Grid.Row="2" Grid.Column="0" Content="COMポート:" Visibility="Collapsed"/>
                    <ComboBox x:Name="SerialPortComboBox" Grid.Row="2" Grid.Column="1" Margin="2" Visibility="Collapsed"/>
                    <Label x:Name="BaudRateLabel" Grid.Row="3" Grid.Column="0" Content="ボーレート:" Visibility="Collapsed"/>
                    <ComboBox x:Name="BaudRateComboBox" Grid.Row="3" Grid.Column="1" Margin="2" Visibility="Collapsed">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>

                    <!-- 接続ボタン -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                              Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                        <Button x:Name="ConnectButton" Content="接続" Width="60" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="切断" Width="60" Margin="5,0,0,0" 
                                Click="DisconnectButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- ログ表示 -->
        <GroupBox Header="ログ" Grid.Row="1" Margin="0,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button x:Name="ClearLogButton" Content="クリア" Width="60"
                            Click="ClearLogButton_Click"/>
                    <Button x:Name="SaveLogButton" Content="保存" Width="60" 
                            Margin="5,0,0,0" Click="SaveLogButton_Click"/>
                </StackPanel>
                <TextBox x:Name="LogTextBox" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </DockPanel>
        </GroupBox>

        <!-- 統計情報 -->
        <GroupBox Header="統計情報" Grid.Row="3" Margin="0,5,0,0">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="送信:" Grid.Row="0" Grid.Column="0"/>
                <TextBlock x:Name="BytesSentText" Grid.Row="0" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Label Content="受信:" Grid.Row="1" Grid.Column="0"/>
                <TextBlock x:Name="BytesReceivedText" Grid.Row="1" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Label Content="エラー:" Grid.Row="2" Grid.Column="0"/>
                <TextBlock x:Name="ErrorCountText" Grid.Row="2" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Label Content="稼働時間:" Grid.Row="3" Grid.Column="0"/>
                <TextBlock x:Name="UptimeText" Grid.Row="3" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Label Content="最終接続:" Grid.Row="4" Grid.Column="0"/>
                <TextBlock x:Name="LastConnectedText" Grid.Row="4" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>

                <Label Content="最終エラー:" Grid.Row="5" Grid.Column="0"/>
                <TextBlock x:Name="LastErrorText" Grid.Row="5" Grid.Column="1" 
                          VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
